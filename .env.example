# Configuración de Entorno de CasaPRO
# Copiar este archivo a .env y ajustar los valores para su entorno local.
# NUNCA versionar el archivo .env ni registrar contraseñas reales.

# Aplicación
APP_NAME=CasaPRO
APP_ENV=local
APP_DEBUG=true
APP_URL=https://app.casa-pro.test
APP_TIMEZONE=America/Lima

# Base de Datos (MySQL / MariaDB en Laragon)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casapro
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Token de API para consulta asistida de DNI/RUC (APIsPERU). Mantener privado en servidor.
APISPERU_DNIRUC_TOKEN=