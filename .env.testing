# Configuración del Entorno Aislado de Pruebas (CasaPRO)
# Exclusivo para suites automatizadas (tests/).

APP_NAME="CasaPRO Testing"
APP_ENV=testing
APP_DEBUG=true
APP_URL=https://app.casa-pro.test
APP_TIMEZONE=America/Lima

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casapro_test
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

APISPERU_DNIRUC_TOKEN=token_testing_dummy
